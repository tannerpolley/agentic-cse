@article{crankPracticalMethodNumerical1947,
  abstract = {This paper is concerned with methods of evaluating numerical solutions of the non-linear partial differential equation where subject to the boundary conditions A, k, q are known constants.Equation (1) is of the type which arises in problems of heat flow when there is an internal generation of heat within the medium; if the heat is due to a chemical reaction proceeding at each point at a rate depending upon the local temperature, the rate of heat generation is often defined by an equation such as (2).},
  author = {Crank, J. and Nicolson, P.},
  doi = {10.1017/S0305004100023197},
  issn = {1469-8064, 0305-0041},
  journal = {Mathematical Proceedings of the Cambridge Philosophical Society},
  langid = {english},
  month = {January},
  number = {1},
  pages = {50--67},
  title = {A Practical Method for Numerical Evaluation of Solutions of Partial Differential Equations of the Heat-Conduction Type},
  urldate = {2026-08-14},
  volume = {43},
  year = {1947}
}
